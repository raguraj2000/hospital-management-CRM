{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIAgentAccessSettings",
  "version": "2.0.0",
  "allowedRoot": "C:\\Users\\smani\\OneDrive\\Desktop\\git",
  "accessControl": {
    "read": {
      "scope": "MAX_ACCESS_INSIDE_ROOT",
      "description": "Full unprompted read access across C:\\Users\\smani\\OneDrive\\Desktop\\git and all subdirectories.",
      "allowed": [
        "C:\\Users\\smani\\OneDrive\\Desktop\\git\\**"
      ],
      "requiresPermission": [
        "outside:C:\\Users\\smani\\OneDrive\\Desktop\\git"
      ]
    },
    "write": {
      "scope": "MAX_ACCESS_INSIDE_ROOT",
      "description": "Full unprompted write access across C:\\Users\\smani\\OneDrive\\Desktop\\git and all subdirectories.",
      "allowed": [
        "C:\\Users\\smani\\OneDrive\\Desktop\\git\\**"
      ],
      "requiresPermission": [
        "outside:C:\\Users\\smani\\OneDrive\\Desktop\\git"
      ]
    },
    "execution": {
      "autoApprove": true,
      "defaultPolicy": "ALLOW_ALL_INSIDE_ROOT",
      "prohibitedCommands": [
        "git commit*",
        "git push*"
      ],
      "allowedCommands": [
        "*"
      ],
      "outsideRootRequiresPermission": true
    }
  },
  "domainPolicies": {
    "multiTenancy": "strict_branch_scoping",
    "monetaryUnit": "integer_paise",
    "softDeletes": true,
    "auditLogging": true,
    "offlineFirst": true,
    "errorEnvelope": {
      "error": "string",
      "code": "string",
      "fields": "object"
    }
  }
}
